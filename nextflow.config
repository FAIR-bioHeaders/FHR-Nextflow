nextflow.enable.dsl = 2
manifest {
    name = 'FHR-Nextflow'
    description = 'Reusable FHR metadata and converter modules'
    version = '0.1.0-dev'
    nextflowVersion = '>=26.04.6'
}
params {
    metadata = null
    id = null
    sequence = null
    sequence_format = 'fasta'
    outdir = 'results'
    converter_source = null
    gff3 = null
    gff3_genome = null
    gff3_header = 'auto'
    gff3_translation_table = null
    gff3_max_findings = null
    gff3_fail_on_errors = true
    fhr_container = 'fhr-nextflow:0.1.0'
}
outputDir = params.outdir
workflow.output.mode = 'copy'
process {
    errorStrategy = 'terminate'
    cpus = 1
    memory = '1 GB'
    time = '30m'
    withLabel: fhr { container = params.fhr_container }
    withName: GFF3_VALIDATE {
        ext.header = params.gff3_header
        ext.translation_table = params.gff3_translation_table
        ext.max_findings = params.gff3_max_findings
        ext.fail_on_errors = params.gff3_fail_on_errors
    }
}
profiles {
    docker {
        docker.enabled = true
        // Run as the invoking user so work and output files are not root-owned.
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
}
